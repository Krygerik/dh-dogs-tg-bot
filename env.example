# Telegram Bot Token (get from @BotFather)
BOT_TOKEN=your_bot_token_here

# Public IP address shown to players
PUBLIC_IP=185.17.66.195

# Path to Dread Hunger server binary
BINARY_PATH=C:\Users\Server\WindowsServer\DreadHunger\Binaries\Win64\DreadHungerServer-Win64-Shipping.exe

# Ports (single, comma separated, or ranges)
PORTS=7777-7782

# Optional Frida injector script (bat/cmd/exe)
FRIDA_PATH=.\frida\python_loader.bat

# External API for client app
API_TOKEN=change_me

# Разработка: APP_ENV=dev подключает Frida-мод predator_damage_multiplier (урон хищников ×2)
# при старте сессии через API. В продакшне не задавать или оставить пустым.
# APP_ENV=dev

# Base port for telemetry HTTP bridge when a session is started with enableTelemetry (API /run)
# Actual port = base + game server port
TELEMETRY_BASE_PORT=8790

# Frida elo_balance_modifiers — см. patches/technical/elo_balance_modifiers/ELO_BALANCE.md
# DH_ELO_BALANCE_SOLO_TEST=1
# DH_ELO_BALANCE_DEBUG=1
# DH_ELO_BALANCE_INGAME_LOG=1
# DH_ELO_BALANCE_DISABLE_FALLBACK=1
#
# Ручные множители (задать хотя бы одну — API балансировщика не вызывается):
# DH_ELO_PREDATOR_DAMAGE_MULT=1.25
# DH_ELO_PREDATOR_HEALTH_MULT=1
# DH_ELO_PLAYER_MELEE_MULT=1.5
# DH_ELO_PLAYER_RANGED_MULT=0.75
